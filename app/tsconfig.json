{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "outDir": "dist-electron",
    "types": ["vitest/globals"]
  },
  "include": ["src", "electron", "vite.config.ts", "vitest.config.ts"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
